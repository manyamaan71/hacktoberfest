# GitHub API Token (Optional, but recommended to avoid rate limits on public repositories)
GITHUB_TOKEN=

# Gemma 4 / Gemini Model Configuration
GEMMA_PROVIDER=google
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4b
GEMMA_API_BASE_URL=

# Agent Execution Settings
MAX_AGENT_STEPS=6
REQUEST_TIMEOUT_SECONDS=30
MAX_REPOSITORY_FILES=1500
MAX_FILE_SIZE_BYTES=524288

# Server Configuration
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=127.0.0.1
